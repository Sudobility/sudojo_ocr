{
  "name": "@sudobility/sudojo_ocr",
  "version": "1.1.55",
  "description": "OCR library for extracting Sudoku puzzles from images (Node.js; recognition via paddle_ocr)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/adapters/node.js",
      "types": "./dist/adapters/node.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json",
    "clean": "rimraf dist",
    "dev": "tsc --watch",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "files": [
    "dist/**/*",
    "CLAUDE.md"
  ],
  "keywords": [
    "typescript",
    "ocr",
    "sudoku",
    "sudojo",
    "image-recognition",
    "paddleocr"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/sudojo_types": "^1.2.79"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@napi-rs/canvas": "~0.1.100",
    "@types/node": "~25.9.9",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "eslint-plugin-react-hooks": "~7.0.1",
    "eslint-plugin-react-refresh": "~0.4.26",
    "globals": "~16.5.0",
    "prettier": "~3.9.10",
    "rimraf": "~6.1.3",
    "tesseract.js": "~5.1.1",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/sudojo_ocr.git"
  }
}
